# Requests are proxied through the Vite dev server at /api (see vite.config.ts),
# which forwards them to BACKEND_ORIGIN. This keeps the browser on one origin, so
# no CORS preflight is involved in development.
#
# Uncomment only when the built bundle is served separately from the API and you
# want the browser to call it directly, e.g. https://api.example.com
# VITE_API_BASE_URL=http://127.0.0.1:8000