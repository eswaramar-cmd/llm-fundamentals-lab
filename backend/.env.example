# ============================================================
# AI Research & Knowledge Agent - Environment Variables
# ============================================================
# Copy this file to .env and adjust values as needed.
# Docker Compose will automatically use .env in the project root.

# ---- LLM / Ollama (Development) ----
# Ollama runs on the Windows host; Docker reaches it via host.docker.internal
# qwen2.5:1.5b is the fastest model that stays coherent on a CPU-only box.
# Swap to llama3.2:3b if you have a GPU.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=96

# ---- LLM Abstraction ----
# Development:  LLM_PROVIDER=ollama, LLM_BASE_URL=http://host.docker.internal:11434
# Production:   LLM_PROVIDER=openai, LLM_MODEL=gpt-4o (LLM_BASE_URL optional)
#
# NOTE: provider priority is explicit. When any cloud key below is set, that
# provider replaces local Ollama, because CPU-only inference costs 7-43s to
# first token versus about 1s from a cloud API.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:1.5b-instruct

# ---- Embeddings ----
# Used for ChromaDB RAG collections.
# KEEP consistent: the same embedding model must be used for
# ingestion AND query to avoid dimension mismatch.
# Default: Ollama nomic-embed-text (768-dim)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=ollama

# ---- Vector Store ----
# Development:  chroma_local  (uses CHROMA_RAG_PATH - shared Docker volume)
# Production:   chroma_server (uses VECTOR_STORE_URL, e.g. http://chroma:8000)
# Alternatives: qdrant, weaviate
VECTOR_STORE_PROVIDER=chroma_local
VECTOR_STORE_URL=
VECTOR_STORE_COLLECTION=documents

# ---- ChromaDB Paths (local) ----
CHROMA_RAG_PATH=./chroma_rag
CHROMA_MEMORY_PATH=./chroma_memory

# ---- Redis (Shared State) ----
# Required for multi-replica deployments. Used for:
#   - LangGraph checkpoint persistence (RedisSaver)
#   - Distributed rate limiting
#   - Background job queue
# Set to empty string to use in-memory checkpointing (single instance only).
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# ---- Documents ----
DOCUMENTS_PATH=./documents
DOC_STORAGE_PROVIDER=local
DOC_STORAGE_BUCKET=
DOC_STORAGE_PREFIX=documents

# ---- Agent Behaviour ----
MAX_RETRIES=3
TOOL_TIMEOUT_SECONDS=30
MAX_TOOL_ITERATIONS=5
RETRY_BACKOFF=2.0

# ---- Rate Limiting (Redis-backed, distributed) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---- CORS ----
# Comma-separated list of allowed origins.
# In Docker: use http://localhost (through Nginx on port 80)
# Local dev: http://localhost:3000,http://localhost:8000
#
# Both loopback spellings must be listed. A browser treats "localhost" and
# "127.0.0.1" as separate origins, so allowing only one means opening the page
# by IP fails the CORS preflight and no response ever arrives.
# 5173 is the Vite dev server (npm run dev in frontend/).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost,http://127.0.0.1

# ---- FastAPI ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Logging ----
# JSON format for production; human-readable for local dev.
LOG_LEVEL=INFO

# ---- Metrics ----
METRICS_ENABLED=true

# ------------------------------------------------------------------
# Speed profile (local CPU box: no GPU)
#
# These are tuned for inference running on CPU only. OLLAMA_NUM_CTX in
# particular matters a lot: the context KV cache competes with the OS for
# RAM, so a large value causes paging and makes every call far slower.
# Only raise it on a machine with a GPU or plenty of free memory.
# ------------------------------------------------------------------
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=2048
CLASSIFY_LLM_FALLBACK=false
RAG_CHUNK_CHAR_LIMIT=500
PARALLEL_LLM_MODEL=qwen2.5:0.5b-instruct
PARALLEL_NUM_PREDICT=56
PARALLEL_RETRIEVE_K=1

# ------------------------------------------------------------------
# FAST CLOUD LLM (backend/agent/llm_fast.py)
#
# Priority is set by LLM_PROVIDER_ORDER, not by which keys happen to be
# present, so adding a key elsewhere cannot silently change the model.
# With no cloud key at all, the app falls back to local Ollama.
#
# Gemini is listed first because it is the provider in use here.
# Free key: https://aistudio.google.com/apikey
# ------------------------------------------------------------------
LLM_PROVIDER_ORDER=google, groq

# gemini-1.5-flash is retired by Google and returns "404 model not found".
# gemini-3.1-flash-lite is the fastest model that still answers (~1s to
# first token). gemini-2.5-flash works too but is roughly 13s.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_TEMPERATURE=0.3
GOOGLE_MAX_TOKENS=1000

# Optional. Free key at https://console.groq.com/keys
# Groq keys start with "gsk_"; a Google key is rejected here with 401.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1000

# ---------------------------------------------------------------------------
# Gmail — real SMTP sending (no OAuth server needed)
# ---------------------------------------------------------------------------
# GMAIL_USER is the mailbox that sends. GMAIL_APP_PASSWORD is a Google App
# Password, NOT your account password.
#
# How to get an App Password:
#   1. Google Account  ->  Security  ->  turn on 2-Step Verification
#   2. Google Account  ->  Security  ->  App Passwords  ->  Create
#   3. Choose "Mail", click Create, copy the 16-character code (spaces removed)
#   4. Paste it below. It only shows once.
#
# Leave GMAIL_APP_PASSWORD blank to disable sending. The tool then refuses with
# a clear error instead of silently doing nothing.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=AI Agent
GMAIL_MAX_PER_HOUR=10

# ---- Attachment limits ----
#
# Storage and email are limited separately, because they answer different
# questions. Storage only needs a backstop against filling the disk; an email
# has a hard external ceiling (Gmail rejects anything over 25 MB, and base64
# adds a third), so it cannot be made unlimited no matter how it is configured.
#
# Raise the storage limits freely. Raise GMAIL_MAX_ATTACHMENT_MB only toward
# ~18; beyond that Gmail itself will refuse the message.
GMAIL_MAX_ATTACHMENT_MB=18
UPLOAD_MAX_FILE_MB=200
UPLOAD_MAX_FILES=50
UPLOAD_MAX_TOTAL_MB=1000
# Refuse new uploads when free disk drops below this, so a full disk produces an
# explanation instead of a half-written file.
UPLOAD_MIN_FREE_MB=512
